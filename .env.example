# ==============================================================================
# CineConcert Ticket Booking Platform - Environment Configuration Template
# Copy this file to .env and replace placeholder values for local or production use
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5000

# SQLite Database Persistence Path
DB_PATH=./data/ticket_booking.db

# Cryptographic & Security Secrets (Replace with cryptographically secure random keys in production)
JWT_SECRET=replace-with-secure-random-jwt-secret-min-32-chars
QR_SECRET=replace-with-secure-random-qr-secret-min-32-chars

# Evaluator & Demo Feature Flags
ENABLE_DEMO_LOGIN=true

# Seat Hold & Waitlist Timing Engine (in seconds)
HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=300

# SMTP / Nodemailer Configuration (Leave USER/PASS empty to auto-generate Ethereal test inbox)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tickets@cineconcert.io
