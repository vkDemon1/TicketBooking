{
  "name": "ticket-booking-platform",
  "version": "1.0.0",
  "description": "Production-Grade Full-Stack Ticket Booking Platform for Movies and Concerts",
  "main": "server/src/index.ts",
  "scripts": {
    "setup": "npm install && cd server && npm install && cd ../client && npm install",
    "seed": "cd server && npm run seed",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "start": "cd server && npm run start",
    "test": "cd server && npm test",
    "test:concurrency": "cd server && npm run test:concurrency",
    "test:ttl": "cd server && npm run test:ttl",
    "test:waitlist": "cd server && npm run test:waitlist",
    "test:booking": "cd server && npm run test:booking",
    "test:qr": "cd server && npm run test:qr",
    "test:checkin": "cd server && npm run test:checkin"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
